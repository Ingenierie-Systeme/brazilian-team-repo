# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace


# Visual Studio
.vs/

# Local editor tooling
/[Aa]ssets/TestBasin/Scripts/Editor/
/[Aa]ssets/TestBasin/Scripts/Editor.meta

# Runtime output
/GroundTruthLogs/

# Unity / Mono crash dumps
mono_crash.*

# Python virtual environment of Tools/cad_analysis
/Tools/cad_analysis/.venv/
__pycache__/

# ROS 2 workspace build outputs
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/

# Videos: too heavy for the repository, the GIFs in Docs/media are kept
*.mp4
