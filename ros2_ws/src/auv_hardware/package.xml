<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_hardware</name>
  <version>0.1.0</version>
  <description>Drivers of the real robot fish (Brazilian Team, ENSTA): Navigator board and pressure sensor.</description>
  <maintainer email="pedrohaa.silva@gmail.com">pedrohaas</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gnc_control</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <!-- bluerobotics_navigator is not a rosdep key: installed with pip, see Docs/Robot_Setup.md -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
